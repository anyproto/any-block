{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/ChatMessage",
    "definitions": {
        "ChatMessage": {
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique message identifier"
                },
                "orderId": {
                    "type": "string",
                    "description": "Lexicographical id for message in order of tree traversal"
                },
                "creator": {
                    "type": "string",
                    "description": "Identifier for the message creator"
                },
                "createdAt": {
                    "type": "string"
                },
                "modifiedAt": {
                    "type": "string"
                },
                "stateId": {
                    "type": "string",
                    "description": "stateId is ever-increasing id (BSON ObjectId) for this message. Unlike orderId, this ID is ordered by the time messages are added. For example, it's useful to prevent accidental reading of messages from the past when a ChatReadMessages request is sent: a message from the past may appear, but the client is still unaware of it"
                },
                "replyToMessageId": {
                    "type": "string",
                    "description": "Identifier for the message being replied to"
                },
                "message": {
                    "$ref": "#/definitions/anytype.model.ChatMessage.MessageContent",
                    "additionalProperties": true,
                    "description": "Message content"
                },
                "attachments": {
                    "items": {
                        "$ref": "#/definitions/anytype.model.ChatMessage.Attachment"
                    },
                    "type": "array",
                    "description": "Attachments slice"
                },
                "reactions": {
                    "$ref": "#/definitions/anytype.model.ChatMessage.Reactions",
                    "additionalProperties": true,
                    "description": "Reactions to the message"
                },
                "read": {
                    "type": "boolean",
                    "description": "Message read status"
                },
                "mentionRead": {
                    "type": "boolean"
                },
                "hasMention": {
                    "type": "boolean"
                },
                "synced": {
                    "type": "boolean"
                },
                "pinned": {
                    "type": "boolean"
                },
                "unreadReaction": {
                    "type": "boolean"
                },
                "blocks": {
                    "items": {
                        "$ref": "#/definitions/anytype.model.ChatMessage.MessageBlock"
                    },
                    "type": "array",
                    "description": "Ordered list of content blocks"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Chat Message"
        },
        "anytype.model.Block.Content.Text.Mark": {
            "properties": {
                "range": {
                    "$ref": "#/definitions/anytype.model.Range",
                    "additionalProperties": true,
                    "description": "range of symbols to apply this mark. From(symbol) To(symbol)"
                },
                "type": {
                    "enum": [
                        "Strikethrough",
                        0,
                        "Keyboard",
                        1,
                        "Italic",
                        2,
                        "Bold",
                        3,
                        "Underscored",
                        4,
                        "Link",
                        5,
                        "TextColor",
                        6,
                        "BackgroundColor",
                        7,
                        "Mention",
                        8,
                        "Emoji",
                        9,
                        "Object",
                        10
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Type"
                },
                "param": {
                    "type": "string",
                    "description": "link, color, etc"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Mark"
        },
        "anytype.model.ChatMessage.Attachment": {
            "properties": {
                "target": {
                    "type": "string",
                    "description": "Identifier for the attachment object"
                },
                "type": {
                    "enum": [
                        "FILE",
                        0,
                        "IMAGE",
                        1,
                        "LINK",
                        2
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Attachment Type"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Attachment"
        },
        "anytype.model.ChatMessage.MessageBlock": {
            "properties": {
                "text": {
                    "$ref": "#/definitions/anytype.model.ChatMessage.MessageBlockText",
                    "additionalProperties": true
                },
                "link": {
                    "$ref": "#/definitions/anytype.model.ChatMessage.MessageBlockLink",
                    "additionalProperties": true
                },
                "embed": {
                    "$ref": "#/definitions/anytype.model.ChatMessage.MessageBlockEmbed",
                    "additionalProperties": true
                },
                "editorQuote": {
                    "$ref": "#/definitions/anytype.model.ChatMessage.MessageBlockEditorQuote",
                    "additionalProperties": true
                },
                "messageQuote": {
                    "$ref": "#/definitions/anytype.model.ChatMessage.MessageBlockMessageQuote",
                    "additionalProperties": true
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Message Block"
        },
        "anytype.model.ChatMessage.MessageBlockEditorQuote": {
            "properties": {
                "blockId": {
                    "type": "string",
                    "description": "id of the quoted block in the source object"
                },
                "content": {
                    "$ref": "#/definitions/anytype.model.ChatMessage.MessageBlockText",
                    "additionalProperties": true,
                    "description": "quoted block content (text, style, marks, ...)"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Message Block Editor Quote"
        },
        "anytype.model.ChatMessage.MessageBlockEmbed": {
            "properties": {
                "text": {
                    "type": "string"
                },
                "processor": {
                    "enum": [
                        "Latex",
                        0,
                        "Mermaid",
                        1,
                        "Chart",
                        2,
                        "Youtube",
                        3,
                        "Vimeo",
                        4,
                        "Soundcloud",
                        5,
                        "GoogleMaps",
                        6,
                        "Miro",
                        7,
                        "Figma",
                        8,
                        "Twitter",
                        9,
                        "OpenStreetMap",
                        10,
                        "Reddit",
                        11,
                        "Facebook",
                        12,
                        "Instagram",
                        13,
                        "Telegram",
                        14,
                        "GithubGist",
                        15,
                        "Codepen",
                        16,
                        "Bilibili",
                        17,
                        "Excalidraw",
                        18,
                        "Kroki",
                        19,
                        "Graphviz",
                        20,
                        "Sketchfab",
                        21,
                        "Image",
                        22,
                        "Drawio",
                        23,
                        "Spotify",
                        24
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Processor"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Message Block Embed"
        },
        "anytype.model.ChatMessage.MessageBlockLink": {
            "properties": {
                "targetObjectId": {
                    "type": "string"
                },
                "type": {
                    "enum": [
                        "Object",
                        0,
                        "File",
                        1,
                        "Image",
                        2,
                        "Bookmark",
                        3
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Link Type"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Message Block Link"
        },
        "anytype.model.ChatMessage.MessageBlockMessageQuote": {
            "properties": {
                "messageId": {
                    "type": "string",
                    "description": "id of the quoted chat message"
                },
                "participantId": {
                    "type": "string",
                    "description": "id of the participant who authored the quoted message"
                },
                "content": {
                    "$ref": "#/definitions/anytype.model.ChatMessage.MessageBlockText",
                    "additionalProperties": true,
                    "description": "quoted message content (text, style, marks, ...)"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Message Block Message Quote"
        },
        "anytype.model.ChatMessage.MessageBlockText": {
            "properties": {
                "text": {
                    "type": "string"
                },
                "style": {
                    "enum": [
                        "Paragraph",
                        0,
                        "Header1",
                        1,
                        "Header2",
                        2,
                        "Header3",
                        3,
                        "Header4",
                        4,
                        "Quote",
                        5,
                        "Code",
                        6,
                        "Title",
                        7,
                        "Checkbox",
                        8,
                        "Marked",
                        9,
                        "Numbered",
                        10,
                        "Toggle",
                        11,
                        "Description",
                        12,
                        "Callout",
                        13,
                        "ToggleHeader1",
                        14,
                        "ToggleHeader2",
                        15,
                        "ToggleHeader3",
                        16
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Style"
                },
                "marks": {
                    "items": {
                        "$ref": "#/definitions/anytype.model.Block.Content.Text.Mark"
                    },
                    "type": "array"
                },
                "checked": {
                    "type": "boolean"
                },
                "lang": {
                    "type": "string"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Message Block Text"
        },
        "anytype.model.ChatMessage.MessageContent": {
            "properties": {
                "text": {
                    "type": "string",
                    "description": "The text content of the message part"
                },
                "style": {
                    "enum": [
                        "Paragraph",
                        0,
                        "Header1",
                        1,
                        "Header2",
                        2,
                        "Header3",
                        3,
                        "Header4",
                        4,
                        "Quote",
                        5,
                        "Code",
                        6,
                        "Title",
                        7,
                        "Checkbox",
                        8,
                        "Marked",
                        9,
                        "Numbered",
                        10,
                        "Toggle",
                        11,
                        "Description",
                        12,
                        "Callout",
                        13,
                        "ToggleHeader1",
                        14,
                        "ToggleHeader2",
                        15,
                        "ToggleHeader3",
                        16
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Style"
                },
                "marks": {
                    "items": {
                        "$ref": "#/definitions/anytype.model.Block.Content.Text.Mark"
                    },
                    "type": "array",
                    "description": "List of marks applied to the text"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Message Content"
        },
        "anytype.model.ChatMessage.Reactions": {
            "properties": {
                "reactions": {
                    "additionalProperties": {
                        "$ref": "#/definitions/anytype.model.ChatMessage.Reactions.IdentityList",
                        "additionalProperties": true
                    },
                    "type": "object",
                    "description": "Map of emoji to list of user IDs"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Reactions"
        },
        "anytype.model.ChatMessage.Reactions.IdentityList": {
            "properties": {
                "ids": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array",
                    "description": "List of user IDs"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Identity List"
        },
        "anytype.model.Range": {
            "properties": {
                "from": {
                    "type": "integer"
                },
                "to": {
                    "type": "integer"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Range",
            "description": "General purpose structure, uses in Mark."
        }
    }
}